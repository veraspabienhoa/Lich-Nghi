# PostgreSQL / Cloud SQL
VERA_DB_ENABLED=1
DB_NAME=vera_spa
DB_USER=vera_app
DB_PASS=CHANGE_ME
INSTANCE_CONNECTION_NAME=YOUR_PROJECT:asia-southeast1:vera-spa-postgres
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=1200
DB_CONNECT_TIMEOUT=10

# Shared PostgreSQL snapshot TTL (seconds)
VERA_PG_TTL_CREDENTIALS=30
VERA_PG_TTL_LEAVE_PRIMARY=45
VERA_PG_TTL_LEAVE_SECONDARY=90
VERA_PG_TTL_TICHLUY=90
VERA_PG_TTL_VIOLATION_DEBT=60
VERA_PG_TTL_PAYROLL_HISTORY=90

# Google Sheets/Drive credentials. Prefer Cloud Run Secret Manager injection.
# If omitted, app tries Streamlit secrets then Cloud Run Application Default Credentials.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Email: keep app password out of source code / container image.
SMTP_SENDER_EMAIL=veraspabienhoa@gmail.com
SMTP_APP_PASSWORD=CHANGE_ME
